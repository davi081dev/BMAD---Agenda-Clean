# Server Configuration
NODE_ENV=development
PORT=3000
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/agenda_clean

# Authentication - Google OAuth 2.0
# Obtenha essas credenciais em: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Authentication - JWT
# Gere uma chave segura aleatória (mínimo 32 caracteres)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Email Service
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=no-reply@agenda-clean.com

# Admin Configuration
ADMIN_EMAIL=admin@agenda-clean.com
